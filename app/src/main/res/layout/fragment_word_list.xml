<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/word_list_fragment"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="?attr/phBGColor"
    android:fitsSystemWindows="true"
    android:translationZ="999dp">
    <!--Search bar-->
    <RelativeLayout
        android:id="@+id/tvLOL"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        android:background="@drawable/search_frame">

        <!--fake focusable, so EditText doesn't get focus on load-->
        <LinearLayout
            android:layout_width="0px"
            android:layout_height="0px"
            android:focusable="true"
            android:focusableInTouchMode="true" />

        <Button
            android:id="@+id/toggleButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="0dp"
            android:background="@android:color/transparent"
            android:minWidth="0dp"
            android:minHeight="55dp"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingTop="0dp"
            android:paddingEnd="6dp"
            android:paddingBottom="0dp"
            android:text="Greek:"
            android:textAllCaps="false"
            android:textColor="?attr/phTextColor"
            android:textSize="21sp" />

        <EditText
            android:id="@+id/word_search"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_toStartOf="@id/clear"
            android:layout_toEndOf="@id/toggleButton"
            android:background="@android:color/transparent"
            android:maxLines="1"
            android:minHeight="55dp"
            android:gravity="center_vertical"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:text=""
            android:textColor="?attr/phTextColor"
            android:textCursorDrawable="@drawable/phcursor"
            android:textIsSelectable="true"
            android:textSize="21sp" />

        <Button
            android:id="@+id/clear"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="0dp"
            android:layout_marginEnd="-8dp"
            android:background="@drawable/xicon"
            android:gravity="center_vertical"
            android:minWidth="55dp"
            android:minHeight="55dp"
            android:onClick="clearSearch"
            android:padding="0dp"
            android:text="" />
    </RelativeLayout>
    <!--End search bar-->
    <LinearLayout
        android:id="@+id/list_container"
        android:layout_width="fill_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/tvLOL"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/progressContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/dbprogressbar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:indeterminate="false"
                android:max="100"
                android:progress="0"
                android:progressTint="?attr/phTextColor" />

            <TextView
                android:id="@+id/dbprogresstext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Updating database..."
                android:textColor="?attr/phTextColor"
                android:textSize="28sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/hideduringcopy"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">

            <ListView
                android:id="@id/android:list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/phBGColor"
                android:choiceMode="singleChoice"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:drawSelectorOnTop="true"
                android:paddingLeft="0dp"
                android:paddingRight="0dp" />

            <Button
                android:id="@+id/settingsButton"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="8dp"
                android:background="@drawable/ic_info_24px"
                android:onClick="openSettings"
                />
        </FrameLayout>
    </LinearLayout>

    <com.philolog.philologus.phkeyboard.PHKeyboardView
        android:id="@+id/keyboardview"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:padding="1dp"
        android:translationZ="999dp"
        android:visibility="gone" />
</RelativeLayout>